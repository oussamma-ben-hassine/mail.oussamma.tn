# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat
RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.json .npmrc* ./
COPY packages/contracts ./packages/contracts
COPY packages/mail-core ./packages/mail-core
COPY packages/integrations ./packages/integrations
COPY apps/api ./apps/api
COPY prisma ./prisma

ENV NODE_ENV=development

RUN pnpm install --no-frozen-lockfile

RUN pnpm --filter @mail/contracts run build
RUN pnpm --filter @mail/mail-core run build
RUN pnpm --filter @mail/integrations run build
RUN PRISMA_GENERATE_SKIP_AUTOINSTALL=true pnpm exec prisma generate --schema=./prisma/schema.prisma
RUN pnpm --filter @mail/api run build

# Stage 2: Runner
FROM node:20-alpine AS runner

WORKDIR /app

RUN apk add --no-cache openssl libc6-compat
RUN npm install -g pnpm@9

ENV NODE_ENV=production
ENV PORT=4000

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.json .npmrc* ./
COPY packages/contracts ./packages/contracts
COPY packages/mail-core ./packages/mail-core
COPY packages/integrations ./packages/integrations
COPY apps/api/package.json ./apps/api/package.json
COPY prisma ./prisma

COPY --from=builder /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder /app/packages/mail-core/dist ./packages/mail-core/dist
COPY --from=builder /app/packages/integrations/dist ./packages/integrations/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist

RUN pnpm install --prod --no-frozen-lockfile
RUN PRISMA_GENERATE_SKIP_AUTOINSTALL=true pnpm exec prisma generate --schema=./prisma/schema.prisma

EXPOSE 4000

CMD ["node", "apps/api/dist/main.js"]
