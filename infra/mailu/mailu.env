# Configuration Mailu pour mail.oussamma.tn
SECRET_KEY=change_this_secret_key_mailu_32bytes_min_2026
DOMAIN=oussamma.tn
HOSTNAMES=mail.oussamma.tn
POSTMASTER=contact
SUBNET=10.99.99.0/24
LOG_LEVEL=INFO

# TLS Let's Encrypt / Certificats Traefik
TLS_FLAVOR=mail-letsencrypt
AUTH_RATELIMIT_IP=10/minute
AUTH_RATELIMIT_USER=50/minute

# Antispam Rspamd
MESSAGE_SIZE_LIMIT=25000000
SCAN_MACROS=True
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Intégration Antivirus (Désactivé par défaut si RAM VPS < 4Go)
ANTIVIRUS=none
