{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@mail/contracts": ["packages/contracts/src"],
      "@mail/mail-core": ["packages/mail-core/src"],
      "@mail/integrations": ["packages/integrations/src"],
      "@mail/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}
