# ========================================================
# Mail.oussamma.tn — Configuration d'Environnement Modèle
# ========================================================

# Environnement d'exécution
NODE_ENV=production
PORT_API=4000
PORT_WEB=3000

# Base de données PostgreSQL (Dédiée à Mail, isolée)
DATABASE_URL=postgresql://mail_user:change_this_password@postgres:5432/mail_db?schema=public

# Cache & Files de messages Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password

# Clé de chiffrement maître des identifiants applicatifs (32 octets hex/base64 pour AES-256-GCM)
APP_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_INTERNAL_SECRET=change_this_long_internal_jwt_secret_for_session_tokens

# SSO Authenticator OIDC (sso-a.oussamma.tn)
SSO_ISSUER=https://sso-a.oussamma.tn
SSO_CLIENT_ID=mail_oussamma_tn
SSO_CLIENT_SECRET=change_this_sso_client_secret
SSO_REDIRECT_URI=https://mail.oussamma.tn/auth/callback
SSO_JWKS_URI=https://sso-a.oussamma.tn/oauth/jwks

# Passerelle LiteLLM IA (ai.oussamma.tn)
LITELLM_BASE_URL=https://ai.oussamma.tn
LITELLM_API_KEY=change_this_litellm_api_key
LITELLM_DEFAULT_MODEL=gpt-4o
LITELLM_FAST_MODEL=gemini/gemini-3.1-flash-lite-preview

# ByteVault Drive (drive.oussamma.tn)
DRIVE_BASE_URL=https://drive.oussamma.tn

# Superviseur Central (supervisor.oussamma.tn)
SUPERVISOR_BASE_URL=https://supervisor.oussamma.tn
SUPERVISOR_KEY=es_mail_change_this_supervisor_key

# Notification Hub
NOTIFICATION_HUB_URL=https://supervisor.oussamma.tn/api/v1/notifications
NOTIFICATION_WEBHOOK_SECRET=change_this_notification_webhook_secret

# Serveur Mailu (Infrastructure IMAP/SMTP)
# En test local : MAIL_DELIVERY_MODE=simulated
# En production : MAIL_DELIVERY_MODE=smtp
MAIL_DELIVERY_MODE=simulated
MAIL_SMTP_HOST=mailu-front
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=system@mail.oussamma.tn
MAIL_SMTP_PASSWORD=change_this_mailu_system_password
MAIL_IMAP_HOST=mailu-front
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true

# Paramètres de sécurité du Webmail
MAIL_MAX_ATTACHMENT_SIZE_MB=25
MAIL_STORAGE_DEFAULT_QUOTA_MB=2048
MAIL_RATE_LIMIT_PER_MINUTE=60
